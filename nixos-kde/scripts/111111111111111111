# Останови и удали контейнеры
docker stop lampac torrserver 2>/dev/null
docker rm lampac torrserver 2>/dev/null

# Удали образы
docker rmi lampac-nixos lampac-offline ghcr.io/yourok/torrserver 2>/dev/null

# (Опционально) Удали ВСЕ неиспользуемые образы и данные Docker
docker system prune -af

rm -rf ~/lampac-data
rm -rf ~/torrserver-data
rm -rf ~/.local/share/docker/lampac*
rm -rf ~/.local/share/docker/torrserver*
